# ---------------------------------------------------------------
# Expense AI - environment variables.  Copy to .env.local and edit.
# NEVER commit .env.local or any real secret.
# ---------------------------------------------------------------

# Where the SQLite database lives. LEAVE UNSET for a safe default:
#   - if the project folder is inside OneDrive/Dropbox/Google Drive/iCloud, the database (and the dev
#     auth secret) go to a per-user LOCAL folder instead (Windows: %LOCALAPPDATA%\ExpenseAI), because
#     cloud-sync clients can corrupt a live SQLite/WAL database and would copy your financial data to the cloud;
#   - otherwise ./data/expense-ai.db.
# Run `npm run db:where` to see the resolved location.
# DATABASE_URL=/absolute/path/to/expense-ai.db      (explicit file; use ":memory:" only for tests)
# EXPENSE_AI_DATA_DIR=/absolute/path/to/data-dir     (explicit directory; db + secret live here)

# Secret used to key session-token hashes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Set to "true" to allow creating a second account. By default the sign-up
# screen only works while NO user exists (single-user personal app).
ALLOW_REGISTRATION=false

# Session lifetime in days (sliding).
SESSION_TTL_DAYS=14

# ------------------------- Optional AI provider -------------------------
# Used ONLY server-side for (a) classifying ambiguous transactions using the
# transaction *description text only* and (b) phrasing chatbot answers from
# numbers already computed from your database. Raw PDFs are never sent.
# Leave AI_API_KEY empty to run fully local / deterministic.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5
# AI_BASE_URL=https://api.anthropic.com

# ------------------------------ Storage ---------------------------------
# Original PDFs are NOT stored. Only parsed transactions are persisted.
# (No storage credentials required.)
